{
  "name": "paws/php-fixture",
  "description": "Minimal Composer project for paws ci --toolchain php",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Example\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Example\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
